# shamefully-hoist stays off so the @wordpress/* runtime packages are not
# flattened into the project root (that is what breaks @wordpress/scripts).
# pnpm's default public-hoist-pattern (*eslint*, *prettier*) is left intact so
# the plugins bundled by @wordpress/eslint-plugin's shared config resolve from
# the root node_modules, which ESLint 8's .eslintrc resolver requires.
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
