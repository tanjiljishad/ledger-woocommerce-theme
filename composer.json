{
    "name": "ledger/monorepo",
    "description": "Ledger — performance-gated WooCommerce theme and plugin suite.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "php-stubs/woocommerce-stubs": "^11.1",
        "php-stubs/wordpress-stubs": "^7.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Ledger\\Core\\": "plugins/core/src/",
            "Ledger\\Blocks\\": "plugins/blocks/src/",
            "Ledger\\Commerce\\": "plugins/commerce/src/",
            "Ledger\\Theme\\": "themes/flagship/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ledger\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "phpcs": "phpcs -q --report=full",
        "phpcbf": "phpcbf",
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    }
}
